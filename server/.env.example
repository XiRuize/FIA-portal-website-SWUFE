# ---------------------------------------------------------------------------
# 后端环境变量示例。用法：复制本文件为 server/.env（或直接设置系统环境变量）。
# 本项目**不依赖 dotenv**：server/src/lib/env.js 会自行读取 server/.env。
# ---------------------------------------------------------------------------

# 监听端口（前端 dev 用 5199/5173，这里避开）
PORT=8787

# 监听地址。127.0.0.1 = 仅本机可访问（配 Nginx 反代时用这个更安全）
HOST=127.0.0.1

# SQLite 数据文件路径。相对路径基于 server/ 目录解析。
DB_PATH=./data/fia.db

# 资料素材根目录（相对路径基于项目根目录解析）。
# 该目录**只读**，服务不会写入或改动其中的任何文件。
MATERIALS_DIR=../资料分享模块素材

# 会话 Cookie 名称
COOKIE_NAME=fia_session

# 会话有效期（小时）。管理员 7 天，浏览账号默认 1 天。
SESSION_TTL_HOURS_ADMIN=168
SESSION_TTL_HOURS_VIEWER=24

# 登录失败限流：同一 IP 在 WINDOW_MS 内失败 MAX 次即锁定 LOCK_MS
LOGIN_MAX_FAILS=5
LOGIN_WINDOW_MS=600000
LOGIN_LOCK_MS=900000

# 后端允许携带 Cookie 的前端来源（CORS 白名单，逗号分隔）。
# 同源部署（Nginx 反代）时无需配置。
CORS_ORIGINS=http://127.0.0.1:5199,http://localhost:5199,http://127.0.0.1:5173,http://localhost:5173

# 新闻抓取：间隔与缓存保留天数（每天至多抓取一次，避免打外部源）
NEWS_REFRESH_MS=86400000
NEWS_KEEP_DAYS=7

# ---------------------------------------------------------------------------
# 首次初始化用的种子账号（仅 scripts/seed.mjs 读取，服务运行时不读）
# ⚠️ 安全提示：这两个账号是「公开示例口令」，首次登录后**必须立刻修改**。
#    修改方式见 README「首次登录后改密码」。
# ---------------------------------------------------------------------------

# 管理权限账号（可多人共用）：可访问 /admin 与 /productions
SEED_ADMIN_USERNAME=<已清除>
SEED_ADMIN_PASSWORD=<已清除>

# 临时浏览权限账号（有有效期）：只能浏览受限内容
SEED_VIEWER_USERNAME=guest
SEED_VIEWER_PASSWORD=<已清除>
# 临时账号有效天数（从种子脚本运行时刻起算）
SEED_VIEWER_DAYS=30
SEED_VIEWER_NOTE=初始演示浏览账号
