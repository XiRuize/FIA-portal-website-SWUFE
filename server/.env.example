# ---------------------------------------------------------------------------
# 后端环境变量示例。用法：复制本文件为 server/.env（或直接设置系统环境变量）。
# 本项目**不依赖 dotenv**：server/src/lib/env.js 会自行读取 server/.env。
# ---------------------------------------------------------------------------

# 监听端口（前端 dev 用 5199/5173，这里避开）
PORT=8787

# 监听地址。127.0.0.1 = 仅本机可访问（配 Nginx 反代时用这个更安全）
HOST=127.0.0.1

# SQLite 数据文件路径。相对路径基于 server/ 目录解析。
DB_PATH=./data/fia.db

# 资料素材根目录（相对路径基于项目根目录解析）。
# 该目录**只读**，服务不会写入或改动其中的任何文件。
MATERIALS_DIR=../资料分享模块素材

# 会话 Cookie 名称
COOKIE_NAME=fia_session

# 会话有效期（小时）。管理员 7 天，浏览账号默认 1 天。
SESSION_TTL_HOURS_ADMIN=168
SESSION_TTL_HOURS_VIEWER=24

# 登录失败限流：同一 IP 在 WINDOW_MS 内失败 MAX 次即锁定 LOCK_MS
LOGIN_MAX_FAILS=5
LOGIN_WINDOW_MS=600000
LOGIN_LOCK_MS=900000

# 后端允许携带 Cookie 的前端来源（CORS 白名单，逗号分隔）。
# 同源部署（Nginx 反代）时无需配置。
CORS_ORIGINS=http://127.0.0.1:5199,http://localhost:5199,http://127.0.0.1:5173,http://localhost:5173

# 新闻抓取：间隔与缓存保留天数（每天至多抓取一次，避免打外部源）
NEWS_REFRESH_MS=86400000
NEWS_KEEP_DAYS=7

# ---------------------------------------------------------------------------
# 反向代理与 Cookie 安全（代码**真的会读**这三个键，不配也能跑但行为不同）
# ---------------------------------------------------------------------------

# 是否信任 X-Forwarded-For / X-Real-IP。
# ⚠️ 默认 false：只在**本机 socket 地址**上取客户端 IP。
#    只有当前面确实有可信反代（Nginx / 云负载均衡）时才设为 true。
#    裸奔或直连时设为 true 会让限流与点赞去重可被任意伪造的请求头绕过。
TRUST_PROXY=false

# Cookie 是否带 Secure 属性（HTTPS 部署时设为 true）。
# 本机 http 开发必须保持 false，否则浏览器不保存会话 Cookie，登录会「成功但立刻失效」。
COOKIE_SECURE=false

# 访客指纹（点赞去重、浏览量统计）的 HMAC 密钥。
# ⚠️ 生产环境**必须**设成一个随机长字符串；留空则退化为不带密钥的哈希，
#    他人可据此反推并伪造指纹，使点赞与访客去重失去意义。
#    生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FINGERPRINT_SECRET=

# ---------------------------------------------------------------------------
# 可选：行情数据源与素材覆写表位置
# ---------------------------------------------------------------------------

# free-stockdb 基址；不可达时后端自动回退腾讯行情，因此可留空。
STOCK_API_BASE=http://127.0.0.1:7899

# 素材元数据覆写表（作品标题/作者/分类覆写）的绝对路径。
# 默认 <项目根>/server/data/production-meta.json，与 MATERIALS_DIR 配套。
# 仅在测试或多实例部署（需要各自独立的覆写表）时才需要显式指定。
RESOURCE_META_PATH=

# ---------------------------------------------------------------------------
# 首次初始化用的种子账号（仅 scripts/seed.mjs 读取，服务运行时不读）
# ---------------------------------------------------------------------------
#
# ⚠️ 本文件**刻意不提供默认口令**。
#
# 默认口令一旦随公开仓库发布，就等于把后台入口一并公开 —— 只要部署时忘了改，
# 它就会在生产环境真实生效。因此这两项改为「必填」：
# 未配置时 scripts/seed.mjs 会直接报错退出，不会用任何内置口令建号。
#
# 【必填】管理权限账号（可多人共用）：可访问 /admin 与 /productions
#   口令要求 >= 8 位（建议 >= 12 位，含大小写字母 / 数字 / 符号）。生成方式：
#   node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=

# 【可选】临时浏览权限账号（有有效期，到期自动失效）：只能浏览受限内容
#   两项都留空则跳过创建；只填一项同样视为未配置。
SEED_VIEWER_USERNAME=
SEED_VIEWER_PASSWORD=
# 临时账号有效天数（从种子脚本运行时刻起算）
SEED_VIEWER_DAYS=30
SEED_VIEWER_NOTE=临时浏览账号
