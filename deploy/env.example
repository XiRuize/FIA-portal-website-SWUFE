# ---------------------------------------------------------------------------
# 后端生产环境配置样本
#
# 用法：
#   cp deploy/env.example server/.env
#   然后逐项填写，务必修改标了「必填」的项。
#
# ⚠️ server/.env 已在 .gitignore 中排除，不会被提交。
# ⚠️ 系统环境变量优先级高于本文件，容器/服务管理器注入的值会覆盖这里。
# ---------------------------------------------------------------------------

# ---- 监听 ----
# 只绑回环。后端不与公网直接接触，所有流量经 Nginx 转发。
# 若改成 0.0.0.0，8787 端口会直接暴露在公网（无 TLS、无限流前置），不要这么做。
HOST=127.0.0.1
PORT=8787

# ---- 运行时 ----
NODE_ENV=production

# ---- 数据文件位置（相对 server/ 解析）----
DB_PATH=./data/fia.db
# 作品元数据覆写表，必须与素材目录成对配置
RESOURCE_META_PATH=./data/production-meta.json

# ---- 素材目录 ----
# 相对 server/ 解析。默认值 `../资料分享模块素材` 的 `..` 就是要跳出 server/。
# 上传素材时请保持同名目录，或在这里改成本机实际路径。
MATERIALS_DIR=../资料分享模块素材

# ---- 会话 Cookie ----
COOKIE_NAME=fia_session
# 【必填】线上是 HTTPS，必须为 true。
# 设 true 但实际没跑 HTTPS → 浏览器拒收 Secure Cookie → 登录后刷新即掉线。
COOKIE_SECURE=true

# ---- 反向代理 ----
# 【必填】挂在 Nginx 之后必须打开。
# 它同时决定「登录限流的 IP 维度」与「点赞指纹」；
# 设为 false 时所有请求被视作同一个 IP，限流会误伤全体访客。
#
# ⚠️ 只在「可信代理会覆写而非追加 XFF」时才可开启。
#    Nginx 配置里的 `proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;`
#    是追加语义，配合下面这条配置使用。若你用的是云厂商 SLB，
#    请确认它同样覆写 XFF，否则关闭本项。
TRUST_PROXY=true

# ---- 指纹密钥 ----
# 【必填】用于点赞去重的 HMAC 密钥。
# 留空时后端会为每个进程生成随机值，表现为「重启后点赞指纹全变、去重失效」。
# 生成方式：openssl rand -hex 32
FINGERPRINT_SECRET=请替换为openssl-rand-hex-32的输出

# ---- 会话有效期（小时）----
SESSION_TTL_HOURS_ADMIN=168
SESSION_TTL_HOURS_VIEWER=24

# ---- 登录防爆破 ----
LOGIN_MAX_FAILS=5
LOGIN_WINDOW_MS=600000
LOGIN_LOCK_MS=900000

# ---- 允许的跨域来源 ----
# 前端与后端同源（经 Nginx /api 反代），生产环境其实用不到 CORS。
# 保留正式域名以便将来接入独立前端或调试工具。
CORS_ORIGINS=https://fia2002.cn,https://www.fia2002.cn

# ---- 新闻缓存 ----
NEWS_REFRESH_MS=86400000
NEWS_KEEP_DAYS=7

# ---- 行情数据源 ----
# 本机 free-stockdb 优先，不可达自动回退腾讯行情。
# 服务器上没有 free-stockdb 时保持这个默认值即可，会自动走腾讯。
STOCK_API_BASE=http://127.0.0.1:7899

# ---- 种子账号（仅首次执行 seed 时读取，服务运行时不读）----
#
# 【必填】管理员账号。不填则 seed 脚本会**拒绝执行**（不会用内置默认口令建号）。
#   口令建议 >= 12 位，含大小写字母 / 数字 / 符号。生成方式：
#   openssl rand -base64 18
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=

# 【可选】临时浏览账号：两项都留空则跳过创建
SEED_VIEWER_USERNAME=
SEED_VIEWER_PASSWORD=
# 临时账号有效天数（从种子脚本运行时刻起算）
SEED_VIEWER_DAYS=30
SEED_VIEWER_NOTE=临时浏览账号
