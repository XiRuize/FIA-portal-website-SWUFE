# ---------------------------------------------------------------------------
# 换行符策略
#
# 背景：本项目开发在 Windows、部署在 Linux。若不显式约束，
# Windows 上打包上传的 shell 脚本会带 CRLF，在服务器上报
#   /bin/bash^M: bad interpreter: No such file or directory
# 这类错误极具误导性（看起来像"文件不存在"，其实是换行符）。
#
# 故：源码与脚本一律以 LF 入库、LF 检出；仅 Windows 专属脚本保留 CRLF。
# ---------------------------------------------------------------------------

* text=auto eol=lf

# Linux 上执行的文件，必须 LF
*.sh      text eol=lf
*.conf    text eol=lf
*.service text eol=lf
*.example text eol=lf
*.env     text eol=lf

# Windows 专属脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制：不做任何转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.zip   binary
*.gz    binary
